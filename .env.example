# ─────────────────────────────────────────────────────────────────────────────
# Inbox Manager configuration
# Copy to .env and edit, or let `npm run setup` write it for you.
# ─────────────────────────────────────────────────────────────────────────────

# === AI provider ===
# llama      — a local OpenAI-compatible model server (default; see host/README.md)
# gemini     — Google AI, needs GEMINI_API_KEY
# claude     — Anthropic API, needs ANTHROPIC_API_KEY
# claude-cli — the Claude Code CLI on this machine
AI_PROVIDER=llama

# === Local model server (AI_PROVIDER=llama) ===
# Same Mac as this checkout:   http://localhost:8080
# Model on a second Mac:       http://192.168.1.50:8080   <- use the IP, NOT a
#   .local name: mlx_lm binds IPv4 only and .local can resolve to IPv6-only.
# This single line is the ONLY difference between the one-Mac and two-Mac setups.
LLAMA_BASE_URL=http://localhost:8080

# Must match a model id reported by GET $LLAMA_BASE_URL/v1/models
LLAMA_MODEL=mlx-community/gemma-4-26B-A4B-it-qat-4bit

# --- Bring your own model server ---------------------------------------
# Anything OpenAI-compatible works, on any OS. Common defaults:
#   llama.cpp / MLX (host/ kit) : http://<ip>:8080
#   Ollama                      : http://<ip>:11434
#   LM Studio                   : http://<ip>:1234
#   vLLM                        : http://<ip>:8000
# A trailing /v1 is accepted too, so a URL copied from Ollama's or LM Studio's
# own docs works as-is.
# The server must listen on the network, not just loopback, and the port must
# be open in the host's firewall. Verify from THIS machine, not the host:
#   curl http://<ip>:<port>/v1/models

# Self-healing (optional). If a run finds the model server unable to generate,
# it can restart it. Set this to an ssh alias or address that reaches the model
# host without a password; leave blank if the model runs on this Mac (a
# loopback LLAMA_BASE_URL is restarted locally). Blank plus a remote URL means
# no automatic restart — the run reports and stops instead.
LLAMA_SSH_HOST=

# How to restart the model server, run on the host. The default assumes macOS
# and launchd. A Linux or Windows host needs its own command, for example:
#   LLAMA_RESTART_CMD=systemctl --user restart ollama
# Set it to empty to disable automatic restarts.
# LLAMA_RESTART_CMD=

# One prefix for every launchd job this project installs:
#   <prefix>.mlx-server, <prefix>.mlx-watchdog, <prefix>.inbox-daily
# Must match LABEL_PREFIX in host/config.sh (or host/config.local.sh) on the
# model host — a run restarts the server by this label.
LAUNCHD_LABEL_PREFIX=com.inbox-manager

# Override only if the model server's label does not follow the prefix above.
# LLAMA_SERVICE_LABEL=

# === Gemini (AI_PROVIDER=gemini) ===
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash | gemini-2.5-flash-lite | gemini-2.0-flash-exp | gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# === Claude (AI_PROVIDER=claude) ===
# Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# opus (most accurate) | sonnet (balanced) | haiku (cheapest)
CLAUDE_MODEL=sonnet

# === Gmail ===
# credentials.json comes from your OWN Google Cloud project (Desktop app OAuth
# client). Set the consent screen to "In production" — a project left in
# "Testing" expires its refresh token after 7 days and forces weekly re-auth.
# token.json is written for you on first authorization.

# Where the daily digest and failure alerts are sent.
# Leave empty to use whichever Gmail account you authorized.
DIGEST_RECIPIENT=

# === Processing ===
# Emails fetched and classified per run.
BATCH_SIZE=50

# true  = classify and print, change nothing (start here)
# false = actually move and mark mail
DRY_RUN=true

# Local SQLite file holding classification history. This is your mail — it is
# git-ignored and never leaves your machine.
DB_PATH=inbox.db
